<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match AppConstants.appGroupID and the app target's entitlements exactly.
	     This one is the easy one to forget on the developer portal: the App Group has
	     to be enabled on the KEYBOARD's App ID too, not just the app's. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mattgroves.giftkey</string>
	</array>
</dict>
</plist>
